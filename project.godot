'; Дворик — Godot 4.3+, 2D, Compatibility (мобилки).
; Формат project.godot как у 4.3 (config_version=5).

config_version=5

[application]

config/name="Dvorik"
config/name_localized={
"ru": "Дворик"
}
config/description="Дворик"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.5, 0.34, 0.18, 1)

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true
pointing/android/enable_long_press_as_right_click=false
pointing/android/enable_pan_and_scale_gestures=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.352941, 0.27451, 0.188235, 1)
